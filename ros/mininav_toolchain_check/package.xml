<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mininav_toolchain_check</name>
  <version>0.5.0</version>
  <description>
    Toolchain checks for consuming the C++23-module MiniNav core from ament packages: a component
    node and a Nav2 controller plugin that import MiniNav modules, loaded by the stock (GCC-built)
    component container and controller_server.
  </description>
  <maintainer email="xinlei-zhu@outlook.com">Xinlei Zhu</maintainer>
  <license>MIT</license>
  <url type="repository">https://github.com/xinlei-robotics/MiniNav</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>mininav_core</depend>
  <depend>ament_index_cpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav2_core</depend>
  <depend>nav_msgs</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>rclcpp_lifecycle</depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>launch_ros</test_depend>
  <test_depend>lifecycle_msgs</test_depend>
  <test_depend>nav2_controller</test_depend>
  <test_depend>rclpy</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
