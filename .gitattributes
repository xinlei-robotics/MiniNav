# Line endings: LF in the index and in every working tree, whatever core.autocrlf
# says. Program output (CSV, path files) is LF, so golden baselines must be too.
* text=auto eol=lf

# Maps: never convert line endings. P5 (binary) pixels must stay byte-exact; P2
# (ASCII, hand-drawn) stays text-diffable because only conversion is disabled.
*.pgm -text

# Binary artifacts.
*.png binary
*.gif binary
*.rrd binary

# Golden CSV baselines are regenerated by the `update_golden` target, not edited
# by hand; collapse them in GitHub diffs.
tests/golden/*.csv linguist-generated=true
